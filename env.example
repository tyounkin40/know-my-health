# Copy to .env.local for local testing with `vercel dev`. Never commit real keys.
ANTHROPIC_API_KEY=sk-ant-...
# Comma-separated list of sites allowed to call the API (leave empty while testing)
ALLOWED_ORIGINS=https://know-my-health.vercel.app,https://demo.mosaiclifetech.com
# Optional
MODEL=claude-haiku-4-5
RATE_PER_HOUR=8
DAILY_CAP=300
